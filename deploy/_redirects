# Keep the Netlify subdomain out of the index; the apex domain is canonical.
https://compoundingjourney.netlify.app/ https://compoundingjourney.com/ 301!
https://compoundingjourney.netlify.app/* https://compoundingjourney.com/:splat 301!

# The home page used to serve all three translations from one document and pick
# one with JavaScript, so "/", "/?lang=en" and "/?lang=pt" were the same bytes
# under three addresses. Each language now has its own pre-rendered page, and
# the query-string addresses are folded into it so their history is not lost.
/ lang=en /en/ 301!
/ lang=pt /pt/ 301!

# Spanish lives at the apex URL. /es/ is the address people guess from the
# other two, so it points there rather than 404ing.
/es/ / 301

# The journal used to render every article from one client-side shell, so each
# translation shared a URL, a canonical and an empty document. Those addresses
# now point at the pre-rendered page for the requested slug.
/en/blog/article.html post=:slug /en/blog/:slug/ 301
/es/blog/article.html post=:slug /es/blog/:slug/ 301
/pt/blog/article.html post=:slug /pt/blog/:slug/ 301
/en/blog/article.html /en/blog/ 301
/es/blog/article.html /es/blog/ 301
/pt/blog/article.html /pt/blog/ 301

# Navigation shortcuts. These used to rewrite to index.html with a 200, which
# served six byte-identical copies of the home page under different URLs.
/pillars /#pilares 301
/simulators /#simulador 301
/tools /#herramientas 301
/templates /#plantillas 301
/faq /#preguntas-frecuentes 301
/assessment /#assessment 301
